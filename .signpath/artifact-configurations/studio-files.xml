<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "studio-files" (a copy of what is set in
  SignPath, kept here so changes are reviewed like code; CODE_SIGNING.md).
  The release workflow uploads the portable folder as a GitHub artifact,
  which GitHub sends as a zip: Studio.exe (one program, with Qt built from
  source and linked in), LICENSE.txt and THIRD-PARTY-NOTICES.txt. Only
  Studio.exe is signed, checked for its product name and the version the
  release workflow passes.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Studio.exe" product-name="FloCMS Studio" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
