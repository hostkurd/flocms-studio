<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Merged by the linker with the manifest it makes (the UAC level). -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- The segment heap (Windows 10 2004 and later; older Windows
           ignore it): it gives freed memory back to the system more
           readily than the default heap, so Studio's memory settles
           lower after it frees screens and project data. -->
      <heapType xmlns="http://schemas.microsoft.com/SMI/2020/WindowsSettings">SegmentHeap</heapType>
    </windowsSettings>
  </application>
</assembly>
