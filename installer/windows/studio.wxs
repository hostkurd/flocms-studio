<?xml version="1.0" encoding="utf-8"?>
<!--
  The Windows installer for FloCMS Studio (design note D12), built with WiX
  Toolset v5 (MS-RL, an OSI-approved license, as SignPath Foundation asks).
  build_msi.sh builds it:
    wix build -arch x64 -d Version=0.1.0 -d SourceDir=<deployed folder>
              -d LicenseRtf=<license.rtf> -ext WixToolset.UI.wixext
              -ext WixToolset.Util.wixext studio.wxs

  For the current user only: no administrator rights, installed to
  %LOCALAPPDATA%\Programs\FloCMS Studio with a Start menu shortcut, and
  removed from Settings > Apps (the uninstaller SignPath Foundation asks
  for). Studio's settings and projects are the user's and stay.

  Per-user files are kept by their own paths, not HKCU keys, so ICE38, ICE64
  and ICE91 are skipped when the package is checked (build_msi.sh): those
  checks are for packages that may also install for all users.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <!-- Never change UpgradeCode: Windows uses it to find the installed
       Studio when a newer one replaces it. (The same GUID as the Inno Setup
       test builds' AppId; those were never released, and an MSI can't
       replace them: uninstall one by hand.) -->
  <Package Name="FloCMS Studio"
           Manufacturer="HostKurd"
           Version="$(var.Version)"
           UpgradeCode="16604886-7502-402D-879A-8B0940B19498"
           Scope="perUser"
           Language="1033"
           Compressed="yes">
    <!-- Subject and Author of the .msi: SignPath checks both before signing
         (.signpath/artifact-configurations/studio-installer.xml) -->
    <SummaryInformation Description="FloCMS Studio $(var.Version) installer" Manufacturer="HostKurd" />

    <!-- A newer Studio replaces the installed one: the old one is removed
         first, then the new one installed, so no file of the old version is
         left; an older one says why it can't. -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of FloCMS Studio is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Launch Condition="VersionNT64" Message="FloCMS Studio needs 64-bit Windows." />
    <!-- No Windows 10 check: Windows Installer reports Windows 10 and 11 as
         8.1 (VersionNT 603) and WINDOWSBUILDNUMBER isn't set on the runners;
         Windows 8.1 is out of support everywhere Studio is used. -->

    <!-- Settings > Apps -->
    <Icon Id="Studio.ico" SourceFile="$(sys.SOURCEFILEDIR)..\..\app\icons\studio.ico" />
    <Property Id="ARPPRODUCTICON" Value="Studio.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/hostkurd/flocms-studio" />
    <Property Id="ARPHELPLINK" Value="https://github.com/hostkurd/flocms-studio/issues" />
    <!-- WixUI_Minimal sets ARPNOMODIFY itself -->
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="FloCMS Studio" />
      </Directory>
    </StandardDirectory>

    <!-- Studio.exe on its own, for the shortcut and "Start FloCMS Studio";
         then everything else in the deployed folder: the FloStudio and Qt
         DLLs, Qt's plugins and QML files, the Visual C++ runtime DLLs,
         LICENSE.txt and THIRD-PARTY-NOTICES.txt. (The final release, stage
         9, installs one static Studio.exe instead.) -->
    <ComponentGroup Id="StudioFiles" Directory="INSTALLFOLDER">
      <Component Id="StudioExe">
        <File Id="StudioExe" Source="$(var.SourceDir)\Studio.exe" KeyPath="yes" />
      </Component>
      <Files Include="$(var.SourceDir)\**">
        <Exclude Files="$(var.SourceDir)\Studio.exe" />
      </Files>
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="StudioShortcut"
                  Name="FloCMS Studio"
                  Description="Create, run and change FloCMS projects"
                  Target="[#StudioExe]"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\HostKurd\FloCMS Studio Installer"
                       Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Studio" Title="FloCMS Studio" AllowAbsent="no">
      <ComponentGroupRef Id="StudioFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- A welcome page with the license, then progress, then a last page
         that offers to start Studio. Arabic and Kurdish installer texts
         come with the final release (stage 9). -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start FloCMS Studio" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#StudioExe]" />
    <CustomAction Id="StartStudio" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="StartStudio"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
  </Package>
</Wix>
